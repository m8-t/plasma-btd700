<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Session bus: name org.btd700ctl.Dongle, object /org/btd700ctl/Dongle.
  All properties are read-only and emit PropertiesChanged.

  Present          dongle HID device is open. When false, all other properties
                   hold defaults (State "none", AudioMode "unknown", Transport
                   "disconnected", empty arrays, 0, false, "").
  State            none, disconnected, connected, streaming-audio, streaming-voice
  AudioMode        high-quality, gaming, broadcast ("unknown" if no dongle or
                   unrecognised value)
  Transport        disconnected, classic, le-audio, multipoint ("unknown" if
                   unrecognised value)
  SupportedCodecs  subset of sbc, aptx, aptx-adaptive, aptx-lossless, aptx-lite, lc3
  ActiveCodecs     same tokens, bitmask from the device so possibly several
  SampleRate       Hz, 0 if unknown
  BitDepth         bits, 0 if unknown
  GamingAvailable  the underlying query is unreliable, false when it fails
  FirmwareVersion  "major.minor.build", empty if not read
  HeadsetBattery   headphone battery level in percent, -1 if unknown. Read
                   over Bluetooth LE through the PC's own adapter (standard
                   Battery Level characteristic, no pairing) when the
                   headphones link to the dongle, before audio plays: the
                   HDB 630 stops advertising over LE once audio plays and
                   until it is switched off. Read again at an interval while
                   nothing has played. Reset to -1 when the headphones leave
                   the dongle.
  HeadsetBatteryUpdated
                   unix time in seconds of the HeadsetBattery reading, 0 if none
  BatteryReading   whether the battery is read at all, the user's choice set
                   with SetBatteryReading and stored in the state directory.
                   On by default. When off, btd700d does no LE scans or
                   connections and HeadsetBattery stays -1.

  Errors: org.freedesktop.DBus.Error.InvalidArgs (unknown mode or codec, codec
  not supported by the dongle), org.btd700ctl.Error.NotPresent (no dongle),
  org.btd700ctl.Error.Failed (HID failure).
  SetAudioMode keeps the current transport unchanged.
  Refresh also tries one headphone battery read at the next moment the dongle
  is not streaming. SetBatteryReading works with or without a dongle.
  Connect and Disconnect are plain HID triggers. The dongle re-establishes the
  link on its own while the headphones are powered on, so Disconnect effectively
  forces a reconnect.
-->
<node>
 <interface name="org.btd700ctl.Dongle1">
  <method name="SetAudioMode">
   <arg type="s" name="mode" direction="in"/>
  </method>
  <method name="SetCodec">
   <arg type="s" name="codec" direction="in"/>
  </method>
  <method name="Connect"/>
  <method name="Disconnect"/>
  <method name="Refresh"/>
  <method name="SetBatteryReading">
   <arg type="b" name="enabled" direction="in"/>
  </method>
  <property name="Present" type="b" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="State" type="s" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="AudioMode" type="s" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="Transport" type="s" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="SupportedCodecs" type="as" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="ActiveCodecs" type="as" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="SampleRate" type="u" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="BitDepth" type="u" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="GamingAvailable" type="b" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="FirmwareVersion" type="s" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="HeadsetBattery" type="i" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="HeadsetBatteryUpdated" type="t" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
  <property name="BatteryReading" type="b" access="read">
   <annotation name="org.freedesktop.DBus.Property.EmitsChangeSignal" value="true"/>
  </property>
 </interface>
</node>
